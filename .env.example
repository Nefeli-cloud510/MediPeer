# MediPeer 后端环境示例。复制为 .env 后按需填写；.env 已被 .gitignore 忽略。
MEDIPEEPER_APP_ENV=development
MEDIPEEPER_DATABASE_URL=sqlite:///./data/medipeer.db
MEDIPEEPER_AUTH_SECRET=replace-with-a-long-random-string
MEDIPEEPER_TOKEN_TTL_SECONDS=43200

# 统一 LLM 适配器：默认 stub（结构化假输出，用于无凭据开发与测试）。
# 真实模型启用示例：provider=openai 或其他平台适配器；密钥只放后端 .env。
MEDIPEEPER_LLM_PROVIDER=stub
MEDIPEEPER_LLM_BASE_URL=
MEDIPEEPER_LLM_API_KEY=
MEDIPEEPER_LLM_MODEL=medipeer-stub
MEDIPEEPER_LLM_TIMEOUT_SECONDS=120
MEDIPEEPER_LLM_TEMPERATURE=
MEDIPEEPER_LLM_MAX_TOKENS=
MEDIPEEPER_MAX_INPUT_CHARS=40000

# 兼容旧环境变量名（若系统已配置 MEDIPEER_LLM_*，可自动读取）。
# MEDIPEER_LLM_PROVIDER=stub
# MEDIPEER_LLM_BASE_URL=
# MEDIPEER_LLM_API_KEY=
# MEDIPEER_LLM_MODEL=medipeer-stub

# 阿里云百炼 / DashScope 兼容模式（可选；配置后 provider 自动切换为真实模型）。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_WORKSPACE_ID=
BAILIAN_KNOWLEDGE_AGENT_ID=
BAILIAN_KNOWLEDGE_AGENT_VERSION=

# 评审演示账号（首版固定弱口令仅用于演示环境，正式部署必须改为强口令）。
MEDIPEEPER_DEMO_PASSWORD=demo1234
MEDIPEEPER_JUDGE_PASSWORD=judge1234
